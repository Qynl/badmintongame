{
  "name": "pitchside",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:render": "node tests/render-smoke.mjs",
    "test:ui": "esbuild tests/ssr-smoke.jsx --bundle --platform=node --format=esm --outfile=.tmp-ssr.mjs --loader:.jsx=jsx --external:react --external:react-dom && node .tmp-ssr.mjs && rm -f .tmp-ssr.mjs",
    "test:all": "npm run test && npm run test:render && npm run test:ui",
    "diag": "node tests/diag.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.28.2",
    "vite": "^5.4.10"
  }
}
